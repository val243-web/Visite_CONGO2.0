<%- include('partials/header') %>
<main>
  <!-- Hero Section inspirée de screen.png -->
  <section class="hero-screen">
    <div class="hero-screen-overlay">
      <div class="hero-screen-content">
        <h1 class="hero-screen-title">
          Bienvenue sur la page <br />
          <span class="hero-highlight">Visite CONGO</span>
        </h1>

        <p class="hero-screen-subtitle">
          Sur cette page vous allez visiter de là où vous êtes notre beau pays la République démocratique du congo et l'étendue de sa biodiversité.
        </p>

        <!-- Les deux boutons d'origine conservés -->
        <div class="hero-btn">
          <a href="/apropos" class="btn accueil-btn btn-green-screen">En savoir plus sur nous</a>
          <a href="/parcs" class="btn accueil-btn btn-outline-screen">Visitez</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Présentation inspirée de screen.png -->
  <section class="presentation-screen">
    <div class="presentation-screen-container">
      <!-- Carte Texte Gauche (avec icône feuille et fond forêt sombre) -->
      <div class="presentation-card-text">
        <div class="presentation-leaf-badge">
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c1 2 2 4.1 2 7 0 4.4-3.6 8-8 8z"/>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
          </svg>
        </div>
        <h2 class="presentation-card-title">
          Une Richesse Écologique Inégalée
        </h2>
        <p class="presentation-card-p">
          La République Démocratique du Congo abrite l'une des biodiversités les plus riches de la planète : plus de 10 000 espèces végétales, 480 espèces de mammifères, 1 086 espèces d'oiseaux, et des animaux endémiques introuvables nulle part ailleurs sur Terre — le bonobo, l'okapi, le gorille des plaines de l'est.
          Découvrez ce patrimoine naturel exceptionnel.
        </p>
      </div>

      <!-- Galerie 2 Images Droite (Okapi & Bonobo) -->
      <div class="presentation-gallery">
        <div class="presentation-img-box">
          <img 
            src="/assets/The only living relative of giraffes, okapi are….jpeg" 
            alt="Okapi de la RDC" 
            loading="lazy" 
            onerror="this.onerror=null; this.src='/okapifaune.jpg';" 
          />
        </div>
        <div class="presentation-img-box">
          <img 
            src="/assets/bonobo.jpg" 
            alt="Bonobo du Congo" 
            loading="lazy" 
            onerror="this.onerror=null; this.src='/animal1.jpeg';" 
          />
        </div>
      </div>
    </div>
  </section>
</main>

<style>
/* Styles specifiques pour reproduire le design de screen.png sur la page d'accueil */

.hero-screen {
    position: relative;
    margin: var(--space-md) 5%;
    border-radius: var(--radius-lg);
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.45) 0%, rgba(10, 20, 10, 0.85) 100%), url('/assets/hero_gorilla.jpg');
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
    overflow: hidden;
}

.hero-screen-overlay {
    width: 100%;
    height: 100%;
    padding: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    border-radius: var(--radius-lg);
}

.hero-screen-content {
    max-width: 850px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.8rem;
}

.hero-screen-title {
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.5px;
}

.hero-highlight {
    color: #d3753b; /* Teinte cuivre/terracotta chaleureuse comme dans screen.png */
    display: inline-block;
    margin-top: 0.2rem;
}

.hero-screen-subtitle {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.6;
    max-width: 650px;
}

/* Styles des 2 boutons adaptes au look de screen.png */
.btn-green-screen {
    background-color: #1bb376 !important;
    color: #ffffff !important;
    padding: 0.85rem 1.8rem !important;
    border-radius: 50px !important;
    font-weight: 700 !important;
    font-size: 0.9rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    transition: all 0.3s ease !important;
    box-shadow: 0 4px 14px rgba(27, 179, 118, 0.4) !important;
}

.btn-green-screen:hover {
    background-color: #159461 !important;
    transform: translateY(-2px) !important;
}

.btn-outline-screen {
    background-color: rgba(255, 255, 255, 0.08) !important;
    color: #ffffff !important;
    padding: 0.85rem 2.2rem !important;
    border-radius: 50px !important;
    border: 1px solid rgba(211, 117, 59, 0.6) !important;
    font-weight: 700 !important;
    font-size: 0.9rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    backdrop-filter: blur(4px) !important;
    transition: all 0.3s ease !important;
}

.btn-outline-screen:hover {
    background-color: rgba(211, 117, 59, 0.2) !important;
    border-color: #d3753b !important;
    transform: translateY(-2px) !important;
}

/* Section Présentation en bas (Look screen.png) */
.presentation-screen {
    margin: 3rem 5% 4rem;
}

.presentation-screen-container {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 2rem;
    align-items: stretch;
}

.presentation-card-text {
    background: linear-gradient(145deg, rgba(40, 50, 42, 0.92) 0%, rgba(20, 28, 22, 0.96) 100%), url('/assets/hero_gorilla.jpg') center/cover;
    background-blend-mode: overlay;
    border-radius: 18px;
    padding: clamp(2rem, 4vw, 3rem);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.2rem;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.presentation-leaf-badge {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(27, 179, 118, 0.2);
    color: #1bb376;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(27, 179, 118, 0.4);
}

.presentation-card-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
}

.presentation-card-p {
    font-size: 0.98rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.88);
}

.presentation-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
}

.presentation-img-box {
    width: 100%;
    height: 100%;
    min-height: 280px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
}

.presentation-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
}

.presentation-img-box:hover img {
    transform: scale(1.06);
}

@media (max-width: 960px) {
    .presentation-screen-container {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .presentation-gallery {
        grid-template-columns: 1fr;
    }
    .presentation-img-box {
        min-height: 220px;
    }
}
</style>

<%- include('partials/footer') %>
